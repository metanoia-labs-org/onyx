(< A Micrograd-inspired scaffold, settled rules only.

   Design: a Value node is never mutated. A method that would update a node
   returns a new node, and the caller rebinds the same name
   (x = x.accumulate(g)). That pattern is valid whether or not the old
   binding counts as consumed, so it does not depend on open questions.
   The local backward rules are pure functions that return the gradient
   contribution; the chain rule is written out by hand for a fixed graph.

   Exercised: #from with * and defaults, #format, instance methods with the
   leading dot, a class method with cls., Class.method(...) calls, lambdas
   with two parameters, real arithmetic, linear rebinding, !i variables.

   !i is used on every node that is read again after being an operand, so
   the snippet does not rely on how method calls consume class instances.
   That question is open.

   Left out on purpose, because still open: tuple children and graph
   traversal, assigning to an attribute, sharing one node between several
   owners, closures that capture, self passed as a value. >)

class Value:
    #from(* data: real, grad: real = 0.0, op: string = "", label: string = "")
    #format = "Value({.data}, grad={.grad}, label={.label})"

    .add(other: Value) -> Value:
        => Value(.data + other.data, 0.0, "+", "add")

    .mul(other: Value) -> Value:
        => Value(.data * other.data, 0.0, "*", "mul")

    .negate() -> Value:
        => .mul(Value.constant(-1.0))

    .subtract(other: Value) -> Value:
        => .add(other.negate())

    (< Same node with its gradient increased: the update is a new value. >)
    .accumulate(delta: real) -> Value:
        => Value(.data, .grad + delta, .op, .label)

    .zero_grad() -> Value:
        => Value(.data, 0.0, .op, .label)

    (< cls. marks a class method: a construction helper. >)
    cls.constant(value: real) -> Value:
        => Value(value, 0.0, "const", "constant")

(< Local backward rules. For l + r both operands receive the upstream
   gradient. For l * r each operand receives the upstream gradient times
   the other operand's data. >)
add_backward(upstream: real) -> real:
    => upstream

mul_backward(upstream: real, other: Value) -> real:
    => upstream * other.data

(< y = w * x + b, the classic starting graph. >)
!i x: Value = Value(-4.0, 0.0, "input", "x")
!i w: Value = Value(2.0, 0.0, "input", "w")
!i b: Value = Value(10.0, 0.0, "const", "b")

!i product: Value = w.mul(x)
output: Value = product.add(b)

(< Seed the output, then run the rules in reverse order. output is linear:
   each rebinding consumes the old node and the new one takes its place. >)
output = output.accumulate(1.0)

b = b.accumulate(add_backward(output.grad))
product = product.accumulate(add_backward(output.grad))
w = w.accumulate(mul_backward(product.grad, x))
x = x.accumulate(mul_backward(product.grad, w))

print("y = {output}")                     (< Expected output: Value(2.0, grad=1.0, label=add) >)
print("dl/dw = {w.grad}")                 (< Expected output: -4.0 >)
print("dl/dx = {x.grad}")                 (< Expected output: 2.0 >)
print("dl/db = {b.grad}")                 (< Expected output: 1.0 >)
print("dl/d(product) = {product.grad}")   (< Expected output: 1.0 >)

(< Finite-difference check on w. epsilon is exactly representable and y is
   linear in w, so the central difference is exact. >)
epsilon: real = 0.5
raised: real = ((w.data + epsilon) * x.data) + b.data
lowered: real = ((w.data - epsilon) * x.data) + b.data
numerical: real = (raised - lowered) / (2.0 * epsilon)
print("numerical dl/dw = {numerical}")    (< Expected output: -4.0 >)

(< A lambda with two parameters and no capture: one gradient descent step
   on w with a fixed rate of 0.5. >)
descent = lambda (current: real, gradient: real) = current - 0.5 * gradient
stepped: real = descent(w.data, w.grad)
after: real = stepped * x.data + b.data
print("w after one step = {stepped}")     (< Expected output: 4.0 >)
print("y after one step = {after}")        (< Expected output: -6.0 >)

(< A composed expression on a fresh pass: x - w is x + (w * -1), so
   d(x-w)/dx = 1 and d(x-w)/dw = -1. >)
x = x.zero_grad()
w = w.zero_grad()

!i minus_one: Value = Value.constant(-1.0)
!i neg_term: Value = w.negate()
difference: Value = x.add(neg_term)

difference = difference.accumulate(1.0)
x = x.accumulate(add_backward(difference.grad))
neg_term = neg_term.accumulate(add_backward(difference.grad))
w = w.accumulate(mul_backward(neg_term.grad, minus_one))

print("x - w = {difference.data}")        (< Expected output: -6.0 >)
print("d(x-w)/dx = {x.grad}")             (< Expected output: 1.0 >)
print("d(x-w)/dw = {w.grad}")             (< Expected output: -1.0 >)
